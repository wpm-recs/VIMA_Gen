# ============================================================
# VIMA_Gen 环境变量模板
#
# 使用方法：
#   cp .env_example .env
#   然后填入你自己的值（.env 已被 .gitignore 忽略，不会上传到 GitHub）
#
# 加载方式：VIMA_Gen/settings.py 启动时用 python-dotenv 自动读取，
#           查找顺序 <项目根>/.env → <项目根>/VIMA_Gen/.env
# 优先级：    CLI 参数  >  .env  >  VIMA_Gen/config.yaml  >  代码内置默认值
# ============================================================

# ------------------------------------------------------------
# OpenAI 兼容接口（必填项只有 OPENAI_API_KEY）
# ------------------------------------------------------------

# 你的 API key。留空时程序会在启动阶段给出明确提示而不是抛底层 401。
OPENAI_API_KEY=sk-your-api-key-here

# 自定义 / 代理网关地址。留空则使用官方默认地址 https://api.openai.com/v1
# 常见例子：
#   Azure / 自建网关: https://your-gateway.example.com/v1
#   本地 vLLM/Ollama:  http://localhost:8000/v1
OPENAI_BASE_URL=

# 对话模型（Step1 提议任务、Step2 生成代码使用）
VIMA_LLM_MODEL=gpt-4.1-mini

# ------------------------------------------------------------
# RAG 嵌入后端
# ------------------------------------------------------------
# local  = sentence-transformers 本地模型（默认，离线，不需要额外的 key）
# openai = OpenAI 兼容的 /embeddings 接口
# 注意：DeepSeek 等网关只提供 chat，没有 /embeddings，所以 embedding 不能复用上面的 base_url
VIMA_EMBEDDING_PROVIDER=local

# provider=local 时生效（HuggingFace 模型 id）
VIMA_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# provider=openai 时生效（独立于上面的 OPENAI_API_KEY / OPENAI_BASE_URL）
VIMA_EMBEDDING_MODEL=text-embedding-3-small
# VIMA_EMBEDDING_BASE_URL=https://api.openai.com/v1
# VIMA_EMBEDDING_API_KEY=sk-...

# 采样温度
VIMA_TEMPERATURE=0.7

# ------------------------------------------------------------
# 运行设备
# ------------------------------------------------------------
# auto（默认，检测到 CUDA 即用 GPU）/ cpu / cuda / cuda:0
VIMA_DEVICE=auto
